# Напрямую из браузера эти файлы не открываются: они работают
# только через /api/index.php. Директивы продублированы для
# старого и нового Apache — на хостингах встречаются оба.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
