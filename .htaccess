# Настройки для Apache. На nginx файл просто игнорируется —
# в этом случае попросите поддержку хостинга включить сжатие и кеш статики.
# Все директивы обёрнуты в IfModule: если модуля нет, сайт продолжит работать.

# Сжатие текстовых файлов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
  # woff2 и webp уже сжаты внутри, повторно их не жмём
</IfModule>

# Кеширование статики в браузере
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png  "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType text/css   "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Главная страница — index.php: он собирает секции «Группы и абонементы»
# и «Команда» из файлов data/groups.json и data/team.json
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Старая ссылка /index.html ведёт на главную
  RewriteRule ^index\.html$ / [R=301,L]

  # Вход в личный кабинет. Короткий адрес /login без расширения:
  # его диктуют вслух и пишут в сообщениях родителям.
  RewriteRule ^login/?$ cabinet/login.html [L]
</IfModule>

# Кодировка по умолчанию
AddDefaultCharset UTF-8
